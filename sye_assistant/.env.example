# Auth.js v5 — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single allowed Google account. Anyone else who completes OAuth is rejected.
ALLOWED_EMAIL=

DATABASE_URL=

# MongoDB — backs the Notes tool (markdown documents). Postgres backs everything
# else. A connection string, e.g. mongodb+srv://user:pass@cluster/...
MONGODB_URI=
# Database name for Notes. Optional — defaults to "sye_assistant" if unset (or if
# the URI already names a database, that takes precedence).
MONGODB_DB=sye_assistant

# Resend (https://resend.com) — outbound email for the morning digest.
RESEND_API_KEY=
# Verified sender, e.g. "Personal Assistant <hello@yourdomain.com>"
RESEND_FROM=

# Shared secret for Vercel Cron route handlers. Generate with: openssl rand -hex 32
CRON_SECRET=

# IANA timezone that defines "today" for date-only features (reminders).
# Optional — defaults to America/New_York if unset.
APP_TIME_ZONE=America/New_York
